{
  "manifest_version": 2,
  "name": "Kitsune",
  "version": "0.3.1",
  "description": "Lets local AI agents control this browser through the Kitsune MCP server",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "browsingData"
  ],
  "optional_permissions": [
    "history",
    "bookmarks"
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/content.js"],
    "run_at": "document_start"
  }],
  "background": {
    "scripts": [
      "background/background.js",
      "background/history.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kitsune@junyeong-nero.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
